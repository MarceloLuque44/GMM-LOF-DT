# Copia este archivo como .env para desarrollo local.
# En Vercel, agrega las mismas variables en Project Settings > Environment Variables.
DATABASE_URL="postgresql://usuario:contrasena@host:5432/base_de_datos?sslmode=require"
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=3
PORT=3001
NODE_ENV=development
# Origen(es) permitidos por CORS, separados por coma. Usa la URL del frontend.
CORS_ORIGIN=http://localhost:5173
